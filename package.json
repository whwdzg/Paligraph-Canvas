{
  "name": "paligraph-canvas",
  "private": true,
  "version": "1.17.1",
  "type": "module",
  "description": "Paligraph Canvas — a Fluent Design web notebook for thinking in ink and markdown.",
  "homepage": "https://whwdzg.github.io/Paligraph-Canvas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/whwdzg/Paligraph-Canvas.git"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "node scripts/qa.mjs",
    "qa:interactions": "node scripts/qa-interactions.mjs",
    "qa:touch": "node scripts/qa-touch.mjs",
    "qa:features": "node scripts/qa-features.mjs",
    "qa:shapes-math": "node scripts/qa-shapes-math.mjs",
    "qa:math-letters": "node scripts/qa-math-letters.mjs",
    "qa:shapes-library": "node scripts/qa-shapes-library.mjs",
    "qa:text": "node scripts/qa-text.mjs",
    "qa:previews": "node scripts/qa-thumbnails.mjs",
    "qa:storage": "node scripts/qa-storage.mjs",
    "qa:folders": "node scripts/qa-folders.mjs",
    "qa:latex": "node scripts/qa-latex.mjs",
    "qa:pwa": "node scripts/qa-pwa.mjs",
    "qa:manifest": "node scripts/qa-manifest.mjs",
    "qa:pwa-files": "node scripts/qa-pwa-files.mjs",
    "qa:wco": "node scripts/qa-wco.mjs",
    "qa:backup": "node scripts/qa-backup.mjs",
    "qa:images": "node scripts/qa-images.mjs",
    "qa:image-resize": "node scripts/qa-image-resize.mjs",
    "qa:pressure": "node scripts/qa-pressure.mjs",
    "qa:color-mix": "node scripts/qa-color-mix.mjs",
    "qa:note-context": "node scripts/qa-note-context.mjs",
    "qa:export": "node scripts/qa-export.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.347",
    "@pwabuilder/manifest-validation": "^0.0.9",
    "dompurify": "^3.4.18",
    "jspdf": "^3.0.4",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "mathjs": "^14.9.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
